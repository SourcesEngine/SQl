WITH RECURSIVE RankHierarchy AS (
    -- Anchor member (starting point)
    SELECT ID, Name, LeaderID, 1 AS Rank
    FROM Students
    WHERE LeaderID IS NULL  -- Baldo is the leader, the root of hierarchy

    UNION ALL

    -- Recursive member (to build the hierarchy)
    SELECT s.ID, s.Name, s.LeaderID, rh.Rank + 1 AS Rank
    FROM Students s
    JOIN RankHierarchy rh ON s.LeaderID = rh.ID
)
SELECT ID, Name, Rank
FROM RankHierarchy
ORDER BY Rank;




CREATE TABLE Students (
    ID INTEGER PRIMARY KEY,
    Name TEXT,
    LeaderID INTEGER,
    FOREIGN KEY (LeaderID) REFERENCES Students(ID)
);



INSERT INTO Students (ID, Name, LeaderID) VALUES
(1, 'Baldo', NULL),        -- Baldo has no leader (root)
(2, 'Cardo', 1),           -- Cardo reports to Baldo
(3, 'Pedro', 1),           -- Pedro reports to Baldo
(4, 'Luningning', 1),      -- Luningning reports to Baldo
(5, 'Paolo', 2),           -- Paolo reports to Cardo
(6, 'Bernardo', 2),        -- Bernardo reports to Cardo
(7, 'Reginaldo', 2),       -- Reginaldo reports to Cardo
(8, 'Roberto', 3),         -- Roberto reports to Pedro
(9, 'Narciso', 3),         -- Narciso reports to Pedro
(10, 'Jopay', 4),          -- Jopay reports to Luningning
(11, 'Policarpio', 10),    -- Policarpio reports to Jopay
(12, 'Sisa', 10);          -- Sisa reports to Jopay


WITH RECURSIVE StudentHierarchy AS (
    -- Anchor member: Select the top-level leader (Baldo)
    SELECT 
        ID,
        Name,
        LeaderID,
        0 AS Rank  -- Start with Baldo as Rank 0
    FROM Students
    WHERE LeaderID IS NULL  -- Baldo is the root (no leader)

    UNION ALL

    -- Recursive member: Find subordinates and increment rank
    SELECT
        s.ID,
        s.Name,
        s.LeaderID,
        sh.Rank + 1 AS Rank  -- Increment rank as we go down the hierarchy
    FROM Students s
    JOIN StudentHierarchy sh ON s.LeaderID = sh.ID
)
SELECT 
    Name, 
    Rank
FROM 
    StudentHierarchy
ORDER BY 
    Rank, Name;





