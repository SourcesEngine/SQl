WITH StudentHierarchy AS (
   -- Anchor member: Select the top-level leader (Baldo)
   SELECT 
      ID,
      Name,
      LeaderID,
      0 AS Rank
   FROM Students
   WHERE LeaderID IS NULL
   UNION ALL
   -- Recursive member: Join with the CTE to find subordinates and increment rank
   SELECT
      s.ID,
      s.Name,
      s.LeaderID,
      sh.Rank + 1 AS Rank
   FROM Students s
   INNER JOIN StudentHierarchy sh ON s.LeaderID = sh.ID
)
SELECT
   Name,
   Rank
FROM StudentHierarchy
ORDER BY Rank, Name;
